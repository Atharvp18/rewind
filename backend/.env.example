# Fetch.ai agents — any random string, no spaces, unique per agent
ORCHESTRATOR_AGENT_SEED=
PRODUCT_AGENT_SEED=
PAYMENT_AGENT_SEED=

# Optional: run as three separate agents. Copy from each agent's startup log.
# Leave empty and the orchestrator runs everything in-process.
PRODUCT_AGENT_ADDRESS=
PAYMENT_AGENT_ADDRESS=

# Vision. REWIND_STUB_VISION=true returns hardcoded Advil until Gate 2.
ANTHROPIC_API_KEY=
REWIND_STUB_VISION=true

# Set later when the backend is wired in
APIFY_TOKEN=
CARTESIA_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
